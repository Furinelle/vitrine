{
  "name": "shirogane",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "worker-build --release",
    "build:dev": "worker-build --dev",
    "dev": "npm run build:dev && wrangler dev",
    "check": "cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test && worker-build --dev",
    "test": "cargo test",
    "db:local": "wrangler d1 migrations apply shirogane --local",
    "db:remote": "wrangler d1 migrations apply shirogane --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.114.0"
  }
}
