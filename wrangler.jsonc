{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shirogane",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "gallery.fontaine.blue",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "shirogane-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shirogane",
      "database_id": "ca5265c6-89a5-41ed-9f1a-a7f91f8c6077"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": ""
  }
}
