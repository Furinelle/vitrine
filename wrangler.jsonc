{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shirogane",
  // Rust workers-rs entry produced by `worker-build` / `npm run build`.
  // TypeScript entry `src/index.ts` is preserved for reference but not used for local dev.
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "gallery.fontaine.blue",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "shirogane-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shirogane",
      "database_id": "ca5265c6-89a5-41ed-9f1a-a7f91f8c6077",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "",
    // Ingest limits (optional; safe defaults applied in Rust if unset/invalid)
    "MAX_FILE_COUNT": "40",
    "MAX_FILE_BYTES": "26214400",
    "MAX_TOTAL_BYTES": "104857600"
  }
}
