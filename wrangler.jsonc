{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vitrine",
  // Rust workers-rs entry produced by `worker-build` / `npm run build`.
  // TypeScript entry `src/index.ts` is preserved for reference but not used for local dev.
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  // Per-request logs with CPU time; Analytics alone cannot attribute 1102s to a route.
  "observability": { "enabled": true },
  "preview_urls": false,
  "routes": [
    {
      "pattern": "gallery.fontaine.blue",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*",
      "/admin",
      "/admin/*"
    ],
    "not_found_handling": "none"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      // Copied from shirogane-media on 2026-10-14; the old bucket is kept only for rollback.
      "bucket_name": "vitrine-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vitrine",
      "database_id": "b7de4fd6-8b7c-46cc-a46f-43278c31065f",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "LOGIN_RATE_LIMITER", "namespace_id": "1952401", "simple": { "limit": 5, "period": 60 } },
    { "name": "PUBLIC_RATE_LIMITER", "namespace_id": "1952402", "simple": { "limit": 120, "period": 60 } }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "",
    // Ingest limits (optional; safe defaults applied in Rust if unset/invalid)
    "MAX_FILE_COUNT": "40",
    "MAX_FILE_BYTES": "52428800",
    "MAX_TOTAL_BYTES": "104857600",
    // S3 endpoint for presigned direct uploads; must name the MEDIA bucket above.
    // R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY are secrets scoped to this bucket.
    "R2_S3_HOST": "162b16d65f8f218eb5c4c4c8bdb9606c.r2.cloudflarestorage.com",
    "R2_BUCKET_NAME": "vitrine-media"
  }
}
